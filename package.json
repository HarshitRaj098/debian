{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "android:apk-smoke": "tsx src/services/apkSmokeCli.ts",
    "android:doctor": "tsx src/services/osCli.ts android doctor",
    "android:smoke-test": "tsx src/services/osCli.ts android smoke-test",
    "android:status": "tsx src/services/androidCli.ts status",
    "android:test-apk": "tsx src/services/androidCli.ts test-apk",
    "android:verify": "tsx src/services/androidCli.ts verify --full",
    "android:quick-install": "tsx src/services/androidCli.ts quick-install",
    "test:bridge": "tsx src/services/runBridgeTest.ts",
    "test:android-verify": "tsx src/services/runAndroidVerifyTest.ts",
    "test:quick-install": "tsx src/services/runQuickInstallTest.ts",
    "browser:doctor": "tsx src/services/browserCli.ts doctor",
    "browser:test": "tsx src/services/browserCli.ts test",
    "os:doctor": "tsx src/services/osCli.ts doctor",
    "os:endgame-test": "tsx src/services/osCli.ts endgame-test"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "uuid": "^14.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "ws": "^8.22.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
